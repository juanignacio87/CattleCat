<UserControl x:Class="Presentation.Views.UCRodeo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="565" 
             d:DesignWidth="925"
             Background="Transparent">
    <!--#region Contenido-->
    <Border CornerRadius="10"
            Background="#76d275">
        <Grid Name="GridRodeos">
            <!--#region Cols & Rows-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="20"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="20"/>
                <RowDefinition/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <!--#endregion-->
            <!--#region Titulo-->
            <TextBlock Text="Rodeos"
                       Foreground="Black"
                       FontSize="45"
                       Grid.Column="2"
                       Grid.Row="1"
                       Grid.ColumnSpan="3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <!--#endregion-->
            <!--#region Establecimiento-->
            <TextBlock Text="Establecimiento:"
                       Grid.Column="1"
                       Grid.Row="3"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox x:Name="cbEstablecimiento" 
                      Grid.Row="3"
                      Grid.Column="2"/>
            <!--#endregion-->
            <!--#region Lote-->
            <TextBlock Text="Lote:"
                       Grid.Column="4"
                       Grid.Row="3"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox x:Name="cbLote" 
                      Grid.Row="3"
                      Grid.Column="5"
                      IsEnabled="False"/>
            <!--#endregion-->
            <!--#region Reproductores-->
            <TextBlock Text="Reproductores:"
                       Grid.Column="2"
                       Grid.Row="5"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBlock Text="Vacas:"
                       Grid.Column="4"
                       Grid.Row="5"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="5"
                     Margin="0,5,0,0"
                     x:Name="tbVacas"/>
            <TextBlock Text="Vaquillonas:"
                       Grid.Column="4"
                       Grid.Row="6"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="6"
                     Margin="0,5,0,0"
                     x:Name="tbVaquillonas"/>
            <TextBlock Text="Toros:"
                       Grid.Column="4"
                       Grid.Row="7"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="7"
                     Margin="0,5,0,0"
                     x:Name="tbToros"/>
            <!--#endregion-->
            <!--#region Cria-->
            <TextBlock Text="Cría:"
                       Grid.Column="2"
                       Grid.Row="9"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBlock Text="Terneros:"
                       Grid.Column="4"
                       Grid.Row="9"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="9"
                     Margin="0,5,0,0"
                     x:Name="tbTerneros"/>
            <!--#endregion-->
            <!--#region Engorde-->
            <TextBlock Text="Engorde:"
                       Grid.Column="2"
                       Grid.Row="11"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBlock Text="Novillos:"
                       Grid.Column="4"
                       Grid.Row="11"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="11"
                     Margin="0,5,0,0"
                     x:Name="tbNovillos"/>
            <TextBlock Text="Vaquillonas:"
                       Grid.Column="4"
                       Grid.Row="12"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       x:Name="tbVaquillonasII"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="12"
                     Margin="0,5,0,0"
                     x:Name="tbVaqEngorde"/>
            <!--#endregion-->
            <!--#region Total-->
            <TextBlock Text="TOTAL:"
                       Grid.Column="4"
                       Grid.Row="14"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       FontWeight="DemiBold"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="14"
                     Margin="0,5,0,0"
                     x:Name="tbTotal"/>
            <!--#endregion-->
        </Grid>
    </Border>
    <!--#endregion-->
</UserControl>
