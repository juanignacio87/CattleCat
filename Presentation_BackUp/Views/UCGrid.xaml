<UserControl x:Class="Presentation.Views.UCGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="565" 
             d:DesignWidth="925"
             Background="Transparent">
    <!--#region Contenido-->
    <Border CornerRadius="10"
            Background="#76d275">
        <Grid Name="GridTotal">
            <!--#region Cols & Rows-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="45"/>
                <RowDefinition/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <!--#endregion-->
            <!--#region Titulo-->
            <TextBlock Text="Grilla de Operaciones"
                       Foreground="Black"
                       FontSize="45"
                       Grid.Column="2"
                       Grid.ColumnSpan="2"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <!--#endregion-->
            <!--#region DataGrid-->
            <DataGrid Template="{DynamicResource DataGridTemplate}" 
                      Grid.Row="2"
                      Grid.ColumnSpan="4"
                      Grid.Column="1"
                      x:Name="GridData"
                      AutoGenerateColumns="False"
                      Background="GhostWhite"
                      Foreground="Black"
                      FontSize="15"
                      CanUserResizeColumns="True"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      RowBackground="Transparent"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="Black"
                      Margin="0,10,0,10"
                      IsReadOnly="True" CanUserReorderColumns="False" AlternationCount="1">
                <DataGrid.AlternatingRowBackground>
                    <SolidColorBrush Color="#FF1D6881" Opacity="0.5"/>
                </DataGrid.AlternatingRowBackground>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha"
                                        Width="100"
                                        Binding="{Binding Fecha}"
                                        ClipboardContentBinding="{x:Null}"
                                        Foreground="Black"/>
                    <DataGridTextColumn Header="Usuario"
                                        Width="100"
                                        Binding="{Binding Nombre}"
                                        ClipboardContentBinding="{x:Null}"
                                        Foreground="Black"/>
                    <DataGridTextColumn Header="Operación"
                                        Width="150"
                                        Binding="{Binding Operacion}"
                                        ClipboardContentBinding="{x:Null}"
                                        Foreground="Black"/>
                    <DataGridTextColumn Header="Establecimiento"
                                        Width="150"
                                        Binding="{Binding Establecimiento}"
                                        ClipboardContentBinding="{x:Null}"
                                        Foreground="Black"/>
                    <DataGridTextColumn Header="Lote"
                                        Width="*"
                                        Binding="{Binding Lote}"
                                        ClipboardContentBinding="{x:Null}"
                                        Foreground="Black"/>
                    <DataGridTextColumn Header="Categoría"
                                        Width="100"
                                        Binding="{Binding Categoria}"
                                        ClipboardContentBinding="{x:Null}"
                                        Foreground="Black"/>
                    <DataGridTextColumn Header="Cantidad"
                                        Width="85"
                                        Binding="{Binding Cantidad}"
                                        ClipboardContentBinding="{x:Null}"
                                        Foreground="Black"/>
                    <DataGridTextColumn/>
                </DataGrid.Columns>
            </DataGrid>
            <!--#endregion-->
            <!--#region Buscador-->
            <!--#region TextBox-->
            <TextBox Style="{DynamicResource TextBoxStyle1}"  
                     Grid.Column="1"
                     Grid.Row="3"/>
            <!--#endregion-->
            <!--#region BtnBuscar-->
            <Button Style="{DynamicResource CRUDButtonStyle}"  
                    Grid.Column="2"
                    Grid.Row="3"
                    x:Name="btnSearch">
                <TextBlock Text="Buscar"
                           FontSize="25"
                           Foreground="White"
                           x:Name="tbSearch"/>
            </Button>
            <!--#endregion-->
            <!--#endregion-->
            <!--#region BtnEditar-->
            <Button Style="{DynamicResource CRUDButtonStyle}" 
                    Grid.Column="3"
                    Grid.Row="3"
                    x:Name="btnEdit">
                <TextBlock Text="Editar"
                           FontSize="25"
                           Foreground="White"/>
            </Button>
            <!--#endregion-->
            <!--#region BtnEliminar-->
            <Button Style="{DynamicResource CRUDButtonStyle}" 
                    Grid.Column="4"
                    Grid.Row="3"
                    x:Name="btnDelete">
                <TextBlock Text="Eliminar"
                           FontSize="25"
                           Foreground="White"/>
            </Button>
            <!--#endregion-->

        </Grid>
    </Border>
    <!--#endregion-->
</UserControl>
