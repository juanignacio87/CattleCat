<Window x:Class="Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Presentation.Views"
        mc:Ignorable="d"
        Title="Cattle Control" 
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent">
    <Window.Resources>
        <DataTemplate x:Name="UCFarm" 
                      DataType="{x:Type viewmodels:UCFarm}">
            <viewmodels:UCFarm DataContext="{Binding}"/>
        </DataTemplate>
    </Window.Resources>
    <!--#region Proyecto-->
    <Border CornerRadius="10"
            Background="GhostWhite">
        <Grid Name="Principal"
              Background="Transparent">
            <Grid.Resources>
                <Style TargetType="TextBlock" 
                       BasedOn="{StaticResource textblockMenu}"/>
                <Style TargetType="Button" 
                       BasedOn="{StaticResource ButtonTemplateShowHide}"/>
            </Grid.Resources>
            <!--#region Header-->
            <Grid Name="Header"
                  Height="35"
                  Background="Transparent"
                  VerticalAlignment="Top">
                <Border CornerRadius="10, 10, 0, 0"
                        Background="#43a047"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <!--#region Title-->
                    <TextBlock Text="Sistema Ganadero"
                               FontSize="25"
                               Grid.Column="0"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0,0,0"/>
                    <!--#endregion-->
                    <!--#region Usuarios-->
                    <Button Style="{DynamicResource ButtonHeaderStyle}"
                            x:Name="btnUsers"
                            Grid.Column="1"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Width="35"
                            Height="35"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,135,0"
                            Cursor="Hand"
                            ToolTip="Administrar usuarios"
                            Click="btnUsers_Click">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE77B;"
                                   FontSize="20"
                                   Foreground="Black"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <!--#endregion-->
                    <!--#region Info-->
                    <Button Style="{DynamicResource ButtonHeaderStyle}" 
                            x:Name="btninfo"
                            Grid.Column="1"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="Black"
                            FontSize="15"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Cursor="Hand"
                            Width="125"
                            Height="35"
                            Click="btnAbout"
                            ToolTip="Contacto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/SCS/IMG/info.png"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"/>
                            <TextBlock Text="Acerca de:"
                                       Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0"/>
                        </Grid>

                    </Button>
                    <!--#endregion-->
                    <!--#region Minimizar-->
                    <Button Style="{DynamicResource ButtonHeaderStyle}"
                            x:Name="btnMinimizar"
                            Grid.Column="2"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Height="25"
                            Width="25"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,5,30,0"
                            Cursor="Hand"
                            ToolTip="Minimizar"
                            Click="Minimizar">
                        <Image Source="/SCS/IMG/minimize.png"
                               Cursor="Hand"/>
                    </Button>
                    <!--#endregion-->
                    <!--#region Cerrar-->
                    <Button x:Name="btnCerrar"
                            Style="{DynamicResource ButtonHeaderStyle}"
                            Grid.Column="2"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Height="25"
                            Width="25"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,5,5,0"
                            Click="Cerrar"
                            ToolTip="Cerrar">
                        <Image Source="/SCS/IMG/close.png"
                               Cursor="Hand"/>
                    </Button>
                    <!--#endregion-->
                </Grid>

            </Grid>
            <!--#endregion-->
            <!--#region Content-->
            <Grid x:Name="GridContent"
                  Background="Transparent"
                  Margin="0, 35, 0, 0"
                  PreviewMouseLeftButtonDown="PreviewMouseLeftButtonDownBG">
                <Border CornerRadius="0, 0, 10, 10"
                        Background="#76d275" 
                        Grid.ColumnSpan="3" 
                        Grid.RowSpan="2"/>
                <!--#region Bienvenida-->
                <Grid Margin="120,55,50,45">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Icono principal -->
                    <Border Grid.Row="0"
                            Width="105"
                            Height="105"
                            CornerRadius="53"
                            Background="#43A047"
                            BorderBrush="#1B5E20"
                            BorderThickness="2"
                            HorizontalAlignment="Center">
                        <Image Source="/SCS/IMG/cow.png"
                               Width="70"
                               Height="70"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <!-- Título -->
                    <StackPanel Grid.Row="1"
                                Margin="0,15,0,0">
                        <TextBlock Text="Cattle Control"
                                   Foreground="#1B5E20"
                                   FontSize="48"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Gestión de establecimientos, lotes y movimientos ganaderos"
                                   Foreground="#333333"
                                   FontSize="21"
                                   Margin="0,7,0,0"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <!-- Separador -->
                    <Border Grid.Row="2"
                            Height="2"
                            Width="180"
                            Background="#43A047"
                            CornerRadius="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    <!-- Mensaje -->
                    <TextBlock Grid.Row="3"
                               Text="Administrá la información del rodeo de forma simple y centralizada."
                               Foreground="#333333"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                    <!-- Capacidades principales -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Operaciones -->
                        <Border Grid.Column="0"
                                Height="150"
                                VerticalAlignment="Center"
                                Background="#EAF5EA"
                                BorderBrush="#43A047"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Operaciones"
                                           Foreground="#1B5E20"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                <TextBlock Text="Registro de movimientos, tareas sanitarias y reproductivas."
                                           Foreground="#444444"
                                           FontSize="15"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Rodeo -->
                        <Border Grid.Column="2"
                                Height="150"
                                VerticalAlignment="Center"
                                Background="#EAF5EA"
                                BorderBrush="#43A047"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Rodeo"
                                           Foreground="#1B5E20"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                <TextBlock Text="Consulta del stock por establecimiento, lote y categoría."
                                           Foreground="#444444"
                                           FontSize="15"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Historial -->
                        <Border Grid.Column="4"
                                Height="150"
                                VerticalAlignment="Center"
                                Background="#EAF5EA"
                                BorderBrush="#43A047"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Historial"
                                           Foreground="#1B5E20"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                <TextBlock Text="Búsqueda, edición y exportación de los registros."
                                           Foreground="#444444"
                                           FontSize="15"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Indicación inferior -->
                    <TextBlock Grid.Row="6"
               Text="Seleccioná una sección desde el menú lateral para comenzar."
               Foreground="#2E7D32"
               FontSize="16"
               FontStyle="Italic"
               TextAlignment="Center"
               HorizontalAlignment="Center"/>
                </Grid>
                <!--#endregion-->

                <!--La siguiente etiqueta hace que
                se muestren los diferentes UsersControls.
                No borrar-->
                <ContentControl Content="{Binding}" 
                                Grid.ColumnSpan="2"
                                Background="Transparent"
                                Margin="70, 0, 0, 0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                x:Name="ContentControl"/>
            </Grid>
            <!--#endregion-->
            <!--#region Sidebar-->
            <Grid x:Name="GridMenu"
                  Background="Transparent"
                  Width="75"
                  HorizontalAlignment="Left"
                  Margin="0,35,0,0">
                <Border Background="#00701a"
                        CornerRadius="0,0,0,10"/>
                <!--#region Menu-->
                <StackPanel Background="Transparent"
                            VerticalAlignment="Top">
                    <!--#region ShowHide-->
                    <Grid Background="Transparent"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Right"
                          Margin="0,10,10,0">
                        <ToggleButton Style="{DynamicResource ToggleButtonStyle1}" 
                                      x:Name="btnShowHide"
                                      Width="30"
                                      Height="30"
                                      Checked="TBShow" 
                                      Unchecked="TBHide" 
                                      HorizontalAlignment="Left"
                                      ToolTip="Expandir/Retraer barra lateral">
                            <ToggleButton.Background>
                                <ImageBrush ImageSource="/SCS/IMG/menu.png"/>
                            </ToggleButton.Background>
                            <ToggleButton.Triggers>
                                <!--#region Hide-->
                                <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                    <BeginStoryboard>
                                        <Storyboard x:Name="HidePanel">
                                            <DoubleAnimation Storyboard.TargetName="GridMenu"
                                                             Storyboard.TargetProperty="Width"
                                                             BeginTime="0:0:0"
                                                             From="200" To="75"
                                                             Duration="0:0:0:0.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <!--#endregion-->
                                <!--#region Show-->
                                <EventTrigger RoutedEvent="ToggleButton.Checked">
                                    <BeginStoryboard>
                                        <Storyboard x:Name="ShowPanel">
                                            <DoubleAnimation Storyboard.TargetName="GridMenu"
                                                             Storyboard.TargetProperty="Width"
                                                             BeginTime="0:0:0"
                                                             From="75" To="200"
                                                             Duration="0:0:0:0.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <!--#endregion-->
                            </ToggleButton.Triggers>
                        </ToggleButton>
                    </Grid>
                    <!--#endregion-->
                    <!--#region Lista-->
                    <ListView Margin="0,30,0,0"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <!--#region Inicio-->
                        <ListViewItem Style="{DynamicResource ListViewItemStyle1}" 
                                      Height="70">
                            <Button Style="{DynamicResource ButtonTemplateShowHide}" 
                                    x:Name="btnStart" Click="btnStart_Click">
                                <Grid Width="200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="50"
                                           Grid.Column="0"
                                           HorizontalAlignment="Center"
                                           Source="/SCS/IMG/house.png"
                                           ToolTip="Página Principal"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="tbInicio"
                                               Text="Inicio"/>
                                </Grid>
                            </Button>
                        </ListViewItem>
                        <!--#endregion-->
                        <!--#region Operaciones-->
                        <ListViewItem Style="{DynamicResource ListViewItemStyle1}"
                                      Height="70">
                            <Button x:Name="btnOperation"
                                    Style="{DynamicResource ButtonTemplateShowHide}" 
                                    Click="btnOperation_Click">
                                <Grid Width="200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="50"
                                           Grid.Column="0"
                                           HorizontalAlignment="Center"
                                           Source="/SCS/IMG/syringe.png"
                                           ToolTip="Registrar Operaciones"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Operaciones"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </ListViewItem>
                        <!--#endregion-->
                        <!--#region Rodeo-->
                        <ListViewItem Style="{DynamicResource ListViewItemStyle1}"
                                      Height="70">
                            <Button Style="{DynamicResource ButtonTemplateShowHide}"
                                    x:Name="btnRodeo" Click="btnRodeo_Click">
                                <Grid Width="200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="50"
                                           Grid.Column="0"
                                           HorizontalAlignment="Center"
                                           Source="/SCS/IMG/cow.png"
                                           ToolTip="Ver Rodeos"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Rodeo"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </ListViewItem>
                        <!--#endregion-->
                        <!--#region Establecimiento-->
                        <ListViewItem Height="70"
                                      Style="{DynamicResource ListViewItemStyle1}">
                            <Button Style="{DynamicResource ButtonTemplateShowHide}"
                                    x:Name="btnFarm" 
                                    Click="btnFarm_Click">
                                <Grid Width="200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="50"
                                           Grid.Column="0"
                                           HorizontalAlignment="Center"
                                           Source="/SCS/IMG/warehouse-solid.png"
                                           ToolTip="Establecimientos"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Establecimiento"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </ListViewItem>
                        <!--#endregion-->
                        <!--#region Grilla Total-->
                        <ListViewItem  Height="70"
                                       Style="{DynamicResource ListViewItemStyle1}">
                            <Button Style="{DynamicResource ButtonTemplateShowHide}"
                                    x:Name="btnGrid" 
                                    Click="btnGrid_Click">
                                <Grid Width="200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="50"
                                           Grid.Column="0"
                                           HorizontalAlignment="Center"
                                           Source="/SCS/IMG/grid.png"
                                           ToolTip="Grilla de Datos"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Total"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </ListViewItem>
                        <!--#endregion-->
                    </ListView>
                    <!--#endregion-->
                </StackPanel>
                <!--#endregion-->
            </Grid>
            <!--#endregion-->

        </Grid>
    </Border>
    <!--#endregion-->
</Window>
