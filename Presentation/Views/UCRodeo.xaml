<UserControl x:Class="Presentation.Views.UCRodeo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="565" 
             d:DesignWidth="925"
             Background="Transparent">
    <!--#region Contenido-->
    <Border CornerRadius="10"
            Background="#76d275">
        <Grid Name="GridRodeos">
            <!--#region Cols & Rows-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition />
                <RowDefinition Height="13"/>
                <RowDefinition />
                <RowDefinition Height="13"/>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="13"/>
                <RowDefinition />
                <RowDefinition Height="13"/>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="15"/>
                <RowDefinition />
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <!--#endregion-->
            <!--#region Titulo-->
            <TextBlock Text="Rodeos"
                       Foreground="Black"
                       FontSize="45"
                       Grid.Column="2"
                       Grid.Row="1"
                       Grid.ColumnSpan="3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <!--#endregion-->
            <!--#region Establecimiento-->
            <TextBlock Text="Establecimiento:"
                       Grid.Column="1"
                       Grid.Row="3"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox x:Name="cbEstablecimiento" 
                      Grid.Row="3"
                      Grid.Column="2"
                      SelectionChanged="cbEstablecimiento_SelectionChanged"
                      Cursor="Hand"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center"
                      FontSize="20"
                      Style="{DynamicResource ComboBoxStyle1}"
                      ToolTip="Seleccionar un Establecimiento."
                      Height="40">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border CornerRadius="10"
                            SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted"
                                 Value="True">
                                            <Setter Property="Background" Value="Yellow"/>
                                            <Setter Property="BorderBrush" Value="Green"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <!--#endregion-->
            <!--#region Lote-->
            <TextBlock Text="Lote:"
                       Grid.Column="4"
                       Grid.Row="3"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox x:Name="cbLote" 
                      Grid.Row="3"
                      Grid.Column="5"
                      IsEnabled="False"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center"
                      FontSize="20"
                      Cursor="Hand"
                      Style="{DynamicResource ComboBoxStyle1}"
                      ToolTip="Seleccionar un lote."
                      SelectionChanged="cbLote_SelectionChanged"
                      Height="40">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border CornerRadius="10"
                            SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted"
                                 Value="True">
                                            <Setter Property="Background" Value="Yellow"/>
                                            <Setter Property="BorderBrush" Value="Green"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <!--#endregion-->
            <!--#region Reproductores-->
            <TextBlock Text="Reproductores:"
                       Grid.Column="2"
                       Grid.Row="5"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBlock Text="Vacas cría:"
                       Grid.Column="4"
                       Grid.Row="5"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="5"
                     Margin="0,5,0,0"
                     x:Name="tbVacas"
                     IsReadOnly="True"
                     Height="40"/>
            <TextBlock Text="Vaquillonas cría:"
                       Grid.Column="4"
                       Grid.Row="6"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="6"
                     Margin="0,5,0,0"
                     x:Name="tbVaquillonas"
                     IsReadOnly="True"
                     Height="40"/>
            <TextBlock Text="Toros:"
                       Grid.Column="4"
                       Grid.Row="7"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="7"
                     Margin="0,5,0,0"
                     x:Name="tbToros"
                     IsReadOnly="True"
                     Height="40"/>
            <!--#endregion-->
            <!--#region Cria-->
            <TextBlock Text="Cría:"
                       Grid.Column="2"
                       Grid.Row="9"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBlock Text="Terneros:"
                       Grid.Column="4"
                       Grid.Row="9"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="9"
                     Margin="0,5,0,0"
                     x:Name="tbTerneros"
                     IsReadOnly="True"
                     Height="40"/>
            <!--#endregion-->
            <!--#region Engorde-->
            <TextBlock Text="Engorde:"
                       Grid.Column="2"
                       Grid.Row="11"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBlock Text="Novillos engorde:"
                       Grid.Column="4"
                       Grid.Row="11"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="11"
                     Margin="0,5,0,0"
                     x:Name="tbNovillos"
                     IsReadOnly="True"
                     Height="40"/>
            <TextBlock Text="Vaquillonas engorde:"
                       Grid.Column="2"
                       Grid.ColumnSpan="3"
                       Grid.Row="12"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="12"
                     Margin="0,5,0,0"
                     x:Name="tbVaqEngorde"
                     IsReadOnly="True"
                     Height="40"/>
            <TextBlock Text="Vacas engorde:"
                       Grid.Column="4"
                       Grid.Row="13"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="13"
                     Margin="0,5,0,0"
                     x:Name="tbVacasEng"
                     IsReadOnly="True"
                     Height="40"/>
            <!--#endregion-->
            <!--#region BUTTON-->
            <Button Grid.Column="2"
                    Grid.Row="15"
                    Grid.RowSpan="2"
                    VerticalAlignment="Top"
                    Style="{DynamicResource CRUDButtonStyle}"
                    Content="Ver Todo"
                    Foreground="White"
                    FontSize="28"
                    x:Name="btnShow" 
                    Click="btnShow_Click"
                    Height="44"/>
            <!--#endregion-->
            <!--#region Total-->
            <TextBlock Text="TOTAL:"
                       Grid.Column="4"
                       Grid.Row="15"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       FontWeight="DemiBold"/>
            <TextBox Grid.Column="5"
                     Style="{DynamicResource TextBoxStyle1}"
                     Grid.Row="15"
                     Margin="0,5,0,0"
                     x:Name="tbTotal"
                     IsReadOnly="True"
                     Height="40"/>
            <!--#endregion-->
        </Grid>
    </Border>
    <!--#endregion-->
</UserControl>
