<Window x:Class="Presentation.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrar usuarios"
        Width="520"
        Height="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent">

    <Border Background="#76D275"
        BorderBrush="#2E7D32"
        BorderThickness="1"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado personalizado -->
            <Border Grid.Row="0"
                Background="#43A047"
                CornerRadius="9,9,0,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                        <Image Source="/SCS/IMG/users.png"
                               Cursor="Hand"/>
                        <TextBlock Text="Administrar usuarios"
                               FontSize="15"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="28"
                            Height="28"
                            Margin="0,4,5,4"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Cursor="Hand"
                            ToolTip="Cerrar"
                            Click="btnClose_Click"
                            Style="{DynamicResource ButtonHeaderStyle}">
                        <Image Source="/SCS/IMG/close.png"
                               Cursor="Hand"/>
                    </Button>
                </Grid>
            </Border>

            <Border Margin="18"
            Grid.Row="1"
            Padding="35, 10, 35, 10"
            CornerRadius="12"
            Background="#E8F5E9">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Administrar usuarios"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#00701A"
                       HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="2"
                       Text="Usuario existente"
                       FontSize="16"
                       Foreground="#263A29"/>

            <ComboBox Grid.Row="4"
                      x:Name="cBoxUser"
                      Style="{DynamicResource ComboBoxStyle1}"
                      SelectedValuePath="Id"
                      SelectionChanged="cBoxUser_SelectionChanged"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center"
                      FontSize="22">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ComboBoxItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                            <Border CornerRadius="10"
                            SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted"
                                 Value="True">
                                                    <Setter Property="Background" 
                                    Value="Yellow"/>
                                                    <Setter Property="BorderBrush" 
                                    Value="Green"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding UserName}"/>
                            <TextBlock Text="{Binding LastName}"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
                <TextBlock Grid.Row="6"
                        Text="Nombre *"
                        FontSize="16"
                        Foreground="#263A29"/>
                    <TextBox Grid.Row="8"
                     x:Name="txtUserName"
                     FontSize="17"
                     Padding="10,0"
                     MaxLength="50"
                     VerticalContentAlignment="Center"
                     Style="{DynamicResource TextBoxStyle1}"/>
            <TextBlock Grid.Row="10"
                       Text="Apellido"
                       FontSize="16"
                       Foreground="#263A29"/>
            <TextBox Grid.Row="12"
                     x:Name="txtLastName"
                     FontSize="17"
                     Padding="10,0"
                     MaxLength="50"
                     VerticalContentAlignment="Center"
                     Style="{DynamicResource TextBoxStyle1}"/>
            <TextBlock Grid.Row="14"
                       Text="Teléfono"
                       FontSize="16"
                       Foreground="#263A29"/>
            <TextBox Grid.Row="16"
                     x:Name="txtCellPhone"
                     FontSize="17"
                     Padding="10,0"
                     MaxLength="10"
                     VerticalContentAlignment="Center"
                     Style="{DynamicResource TextBoxStyle1}"/>
            <Grid Grid.Row="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnAdd"
                        Style="{DynamicResource CRUDButtonStyle}"
                        Click="btnAdd_Click"
                        Cursor="Hand">
                    <TextBlock Text="Agregar"
                               FontSize="18"
                               Foreground="White"/>
                </Button>

                <Button Grid.Column="2"
                        x:Name="btnEdit"
                        Style="{DynamicResource CRUDButtonStyle}"
                        Click="btnEdit_Click"
                        Cursor="Hand"
                        IsEnabled="False">
                    <TextBlock Text="Actualizar"
                               FontSize="18"
                               Foreground="White"/>
                </Button>

                <Button Grid.Column="4"
                        x:Name="btnDelete"
                        Style="{DynamicResource CRUDButtonStyle}"
                        Click="btnDelete_Click"
                        Cursor="Hand"
                        IsEnabled="False">
                    <TextBlock Text="Eliminar"
                               FontSize="18"
                               Foreground="White"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
        </Grid>
    </Border>
</Window>
