<UserControl x:Class="Presentation.Views.UCDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Background="#76d275"
            Padding="35">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Panel general"
                           FontSize="42"
                           FontWeight="SemiBold"
                           Foreground="#102713"/>

                <TextBlock Text="Resumen actual del sistema ganadero"
                           FontSize="18"
                           Foreground="#355E3B"
                           Margin="2,4,0,0"/>
            </StackPanel>

            <!-- Tarjetas -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Stock -->
                <Border Grid.Column="0"
                        Background="#F8FFF8"
                        CornerRadius="14"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Stock total"
                                   FontSize="17"
                                   Foreground="#527057"/>

                        <TextBlock x:Name="tbTotalStock"
                                   Text="0"
                                   FontSize="43"
                                   FontWeight="Bold"
                                   Foreground="#00701A"/>

                        <TextBlock Text="animales"
                                   FontSize="15"
                                   Foreground="#527057"/>
                    </StackPanel>
                </Border>

                <!-- Establecimientos -->
                <Border Grid.Column="2"
                        Background="#F8FFF8"
                        CornerRadius="14"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Establecimientos"
                                   FontSize="17"
                                   Foreground="#527057"/>

                        <TextBlock x:Name="tbFarms"
                                   Text="0"
                                   FontSize="43"
                                   FontWeight="Bold"
                                   Foreground="#00701A"/>

                        <TextBlock Text="activos"
                                   FontSize="15"
                                   Foreground="#527057"/>
                    </StackPanel>
                </Border>

                <!-- Lotes -->
                <Border Grid.Column="4"
                        Background="#F8FFF8"
                        CornerRadius="14"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Lotes"
                                   FontSize="17"
                                   Foreground="#527057"/>

                        <TextBlock x:Name="tbLots"
                                   Text="0"
                                   FontSize="43"
                                   FontWeight="Bold"
                                   Foreground="#00701A"/>

                        <TextBlock Text="activos"
                                   FontSize="15"
                                   Foreground="#527057"/>
                    </StackPanel>
                </Border>

                <!-- Registros -->
                <Border Grid.Column="6"
                        Background="#F8FFF8"
                        CornerRadius="14"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Registros"
                                   FontSize="17"
                                   Foreground="#527057"/>

                        <TextBlock x:Name="tbRecords"
                                   Text="0"
                                   FontSize="43"
                                   FontWeight="Bold"
                                   Foreground="#00701A"/>

                        <TextBlock Text="operaciones activas"
                                   FontSize="14"
                                   Foreground="#527057"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Último registro -->
            <Border Grid.Row="4"
                    Background="#E8F5E9"
                    BorderBrush="#43A047"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>
                    <TextBlock Text="Último registro"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#00701A"/>

                    <TextBlock x:Name="tbLastRecord"
                               Text="Sin movimientos"
                               FontSize="17"
                               Foreground="#263A29"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Accesos rápidos -->
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Nueva operación"
                        Width="180"
                        Height="45"
                        Margin="0,0,14,0"
                        Cursor="Hand"/>

                <Button Content="Ver rodeos"
                        Width="150"
                        Height="45"
                        Margin="0,0,14,0"
                        Cursor="Hand"/>

                <Button Content="Ver registros"
                        Width="160"
                        Height="45"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>