<UserControl x:Class="Presentation.Views.UCOperation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.Views"
             xmlns:ops="clr-namespace:Logic;assembly=Logic"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="565" 
             d:DesignWidth="925"
             Background="Transparent">
    <!--#region Contenido-->
    <Border CornerRadius="10"
            Background="#76d275">
        <Grid Name="GridOperaciones"
              Background="Transparent"
              MaxWidth="1050"
              HorizontalAlignment="Center">
            <!--#region COLS & ROWS-->
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="25"/>
            </Grid.ColumnDefinitions>
            <!--#endregion-->
            <!--#region Titulo-->
            <TextBlock Text="Operaciones"
                       Foreground="Black"
                       FontSize="45"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Height="58"
                       Width="256" 
                       Grid.Column="3"
                       Grid.Row="1"
                       Grid.ColumnSpan="3"
                       Grid.RowSpan="3"/>
            <!--#endregion-->
            <!--#region AYUDA-->
            <Border CornerRadius="10"
                    Grid.Column="7"
                    Grid.Row="1"
                    Grid.RowSpan="2">
                <Button Width="40"
                        Height="40"
                        Background="Green"
                        x:Name="btnHelp" 
                        Click="btnHelp_Click"
                        ToolTip="Ayuda">
                    <Image Source="/SCS/IMG/question-solid.png"/>
                </Button>
            </Border>
            <!--#endregion-->
            <!--#region Establecimiento-->
            <TextBlock Text="Establecimiento:"
                       FontSize="25"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Grid.Row="3"
                       Grid.RowSpan="2"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Height="45"
                       Width="184"/>
            <ComboBox x:Name="cbEstablecimiento"
                      Height="45"
                      Width="230"
                      Grid.Row="3"
                      Grid.RowSpan="2"
                      Grid.Column="3"
                      Grid.ColumnSpan="2"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center"
                      FontSize="22"
                      Cursor="Hand"
                      DisplayMemberPath="NomEstablecimientos"
                      SelectedValuePath="Id"
                      SelectionChanged="cbEstablecimiento_SelectionChanged"
                      Style="{DynamicResource ComboBoxStyle1}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border CornerRadius="10"
                                            SnapsToDevicePixels="True"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted"
                                                 Value="True">
                                            <Setter Property="Background" Value="Yellow"/>
                                            <Setter Property="BorderBrush" Value="Green"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <!--#endregion-->
            <!--#region Lote-->
            <TextBlock Text="Lote:"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Grid.Row="3"
                       Grid.RowSpan="2"
                       Grid.Column="5"
                       Height="41"
                       Width="60" 
                       RenderTransformOrigin="0.71,1.031"/>
            <ComboBox x:Name="cbLote" 
                      IsEnabled="False"
                      Height="45" 
                      Width="230"
                      Grid.Row="3"
                      Grid.RowSpan="2"
                      Grid.Column="6"
                      Grid.ColumnSpan="3"
                      HorizontalAlignment="Center"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center"
                      FontSize="22"
                      Cursor="Hand"
                      Style="{DynamicResource ComboBoxStyle1}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border CornerRadius="10"
                            SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted"
                                 Value="True">
                                            <Setter Property="Background" Value="Yellow"/>
                                            <Setter Property="BorderBrush" Value="Green"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <!--#endregion-->
            <!--#region Operacion-->
            <GroupBox x:Name="gboxOperaciones" 
                      Width="500"
                      Height="388" 
                      Grid.Row="4"
                      Grid.RowSpan="10"
                      Grid.Column="1"
                      Grid.ColumnSpan="4"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Left"
                      VerticalContentAlignment="Center"
                      Cursor="Hand"
                      FontSize="25"
                      BorderBrush="Yellow"
                      BorderThickness="1">
                <GroupBox.Header>
                    <Label Content="Operaciones"/>
                </GroupBox.Header>
                <!--
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox VerticalContentAlignment="Center"
                                  Content="{Binding OperationName}"
                                  IsChecked="{Binding Selected}"
                                  />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                -->
                <Grid Cursor="Hand"
                      x:Name="grChBoxes">
                    <!--#region COLUMNS AND ROWS DEF-->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!--#endregion-->
                    <!--#region CHECKBOXES-->
                    <CheckBox Content="Aftosa"
                              VerticalContentAlignment="Center"
                              x:Name="chbAftosa" 
                              Checked="chbAftosa_Checked"
                              CommandParameter="1"
                              Grid.Column="0"
                              Grid.Row="0"
                              Tag="1" 
                              Unchecked="chbAftosa_Unchecked"/>
                    <CheckBox Content="Antidiarreico"
                              VerticalContentAlignment="Center"
                              x:Name="chbDiarreico" 
                              Checked="chbDiarreico_Checked"
                              Grid.Column="0"
                              Grid.Row="1"
                              Tag="17"
                              CommandParameter="14" 
                              Unchecked="chbDiarreico_Unchecked"/>
                    <CheckBox Content="Antiparasitario"
                              VerticalContentAlignment="Center"
                              x:Name="chbAntipa" 
                              Checked="chbAntipa_Checked"
                              Grid.Column="0"
                              Grid.Row="2" 
                              Tag="2"
                              CommandParameter="2" 
                              Unchecked="chbAntipa_Unchecked"/>
                    <CheckBox Content="Brucelosis"
                              VerticalContentAlignment="Center"
                              x:Name="chbBrucelosis" 
                              Checked="chbBrucelosis_Checked"
                              Grid.Column="0"
                              Grid.Row="3"
                              Tag="3"
                              CommandParameter="3" Unchecked="chbBrucelosis_Unchecked"/>
                    <CheckBox Content="Carbunclo"
                              VerticalContentAlignment="Center"
                              x:Name="chbCarb" 
                              Checked="chbCarb_Checked"
                              Grid.Column="0"
                              Grid.Row="4"
                              Tag="18"
                              CommandParameter="14" Unchecked="chbCarb_Unchecked"/>
                    <CheckBox Content="Castración"
                              VerticalContentAlignment="Center"
                              x:Name="chbCastra" 
                              Checked="chbCastra_Checked"
                              Grid.Column="0"
                              Grid.Row="5"
                              CommandParameter="4"
                              Tag="4" Unchecked="chbCastra_Unchecked"/>
                    <CheckBox Content="Conteo"
                              VerticalContentAlignment="Center"
                              x:Name="chbConteo" 
                              Checked="chbConteo_Checked"
                              Grid.Column="0"
                              Grid.Row="6"
                              Tag="5"
                              CommandParameter="5" Unchecked="chbConteo_Unchecked"/>
                    <CheckBox Content="Destete"
                              VerticalContentAlignment="Center"
                              x:Name="chbDestete" 
                              Checked="chbDestete_Checked"
                              Grid.Column="0"
                              Grid.Row="7"
                              Tag="6"
                              CommandParameter="6" Unchecked="chbDestete_Unchecked"/>
                    <CheckBox Content="Ecografía"
                              VerticalContentAlignment="Center"
                              x:Name="chbEcografia" 
                              Checked="chbEcografia_Checked"
                              Grid.Column="0"
                              Grid.Row="8"
                              Tag="7"
                              CommandParameter="7" Unchecked="chbEcografia_Unchecked"/>
                    <CheckBox Content="Entrada"
                              VerticalContentAlignment="Center"
                              x:Name="chbEntrada" 
                              Checked="chbEntrada_Checked"
                              Grid.Column="1"
                              Grid.Row="0"
                              Tag="8"
                              CommandParameter="8" Unchecked="chbEntrada_Unchecked"/>
                    <CheckBox Content="Inseminación"
                              VerticalContentAlignment="Center"
                              x:Name="chbInseminacion" 
                              Checked="chbInseminacion_Checked"
                              Grid.Column="1"
                              Grid.Row="1"
                              Tag="9"
                              CommandParameter="9" Unchecked="chbInseminacion_Unchecked"/>
                    <CheckBox Content="IR9"
                              VerticalContentAlignment="Center"
                              x:Name="chbIR9" 
                              Checked="chbIR9_Checked"
                              Grid.Column="1"
                              Grid.Row="2"
                              Tag="10"
                              CommandParameter="10" Unchecked="chbIR9_Unchecked"/>
                    <CheckBox Content="Muerte"
                              VerticalContentAlignment="Center"
                              x:Name="chbMuerte" 
                              Checked="chbMuerte_Checked"
                              Grid.Column="1"
                              Grid.Row="3"
                              Tag="11"
                              CommandParameter="11" Unchecked="chbMuerte_Unchecked"/>
                    <CheckBox Content="Nacimiento"
                              VerticalContentAlignment="Center"
                              x:Name="chbNacimiento" 
                              Checked="chbNacimiento_Checked"
                              Grid.Column="1"
                              Grid.Row="4"
                              Tag="12"
                              CommandParameter="12" Unchecked="chbNacimiento_Unchecked"/>
                    <CheckBox Content="Queratoconjuntivitis"
                              VerticalContentAlignment="Center"
                              x:Name="chbQuerato" 
                              Checked="chbQuerato_Checked"
                              Grid.Column="1"
                              Grid.Row="5"
                              Tag="15"
                              CommandParameter="14" Unchecked="chbQuerato_Unchecked"/>
                    <CheckBox Content="Reproductiva"
                              VerticalContentAlignment="Center"
                              x:Name="chbReproductiva" 
                              Checked="chbReproductiva_Checked"
                              Grid.Column="1"
                              Grid.Row="6"
                              Tag="13"
                              CommandParameter="13" Unchecked="chbReproductiva_Unchecked"/>
                    <CheckBox Content="Salida"
                              VerticalContentAlignment="Center"
                              x:Name="chbSalida" 
                              Checked="chbSalida_Checked"
                              Grid.Column="1"
                              Grid.Row="7"
                              Tag="14"
                              CommandParameter="14" Unchecked="chbSalida_Unchecked"/>
                    <CheckBox Content="Sarna/Garrapata"
                              VerticalContentAlignment="Center"
                              x:Name="chbSarna" 
                              Checked="chbSarna_Checked"
                              Grid.Column="1"
                              Grid.Row="8"
                              Tag="16"
                              CommandParameter="16" Unchecked="chbSarna_Unchecked"/>
                    <!--#endregion-->
                    <!--
                    <GroupItem Grid.Column="0"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="0"
                                 x:Name="lbiAftosa" 
                                 Selected="chbAftosa_Checked">
                        <CheckBox Content="Aftosa"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbAftosa" 
                                  Checked="chbAftosa_Checked"
                                  CommandParameter="1"/>
                    </GroupItem>
                    <GroupItem Grid.Column="0"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="1"
                                 Margin="0,3"
                                 x:Name="lbiAntipa">
                        <CheckBox Content="Antiparasitario"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbAntipa" 
                                  Checked="chbAntipa_Checked"/>
                    </GroupItem>
                    <ListBoxItem Grid.Column="0"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="2"
                                 Margin="0,3">
                        <CheckBox Content="Brucelosis"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbBrucelosis" 
                                  Checked="chbBrucelosis_Checked"/>
                    </ListBoxItem>
                    <ListBoxItem Grid.Column="0"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="3"
                                 Margin="0,3">
                        <CheckBox Content="Castración"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbCastra" 
                                  Checked="chbCastra_Checked"/>
                    </ListBoxItem>
                    <ListBoxItem Grid.Column="0"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="4"
                                 Margin="0,3">
                        <CheckBox Content="Conteo"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbConteo" 
                                  Checked="chbConteo_Checked"/>
                    </ListBoxItem>
                    <ListBoxItem Grid.Column="0"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="5"
                                 Margin="0,3">       
                        <CheckBox Content="Destete"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbDestete" 
                                  Checked="chbDestete_Checked"/>
                    </ListBoxItem>
                    <ListBoxItem Grid.Column="0"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="6"
                                 Margin="0,3">   
                        <CheckBox Content="Ecografía"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbEcografia" 
                                  Checked="chbEcografia_Checked"/>
                    </ListBoxItem>
                    <ListBoxItem Grid.Column="1"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="0">
                        <CheckBox Content="Entrada"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbEntrada" 
                                  Checked="chbEntrada_Checked"/>
                    </ListBoxItem>
                    <ListBoxItem Grid.Column="1"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="1"
                                 Margin="0,3">
                        <CheckBox Content="Inseminación"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbInseminacion" 
                                  Checked="chbInseminacion_Checked"/>
                    </ListBoxItem>
                    <ListBoxItem Grid.Column="1"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="2"
                                 Margin="0,3">
                        <CheckBox Content="IR9"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbIR9" 
                                  Checked="chbIR9_Checked"/>
                    </ListBoxItem>
                    <ListBoxItem Grid.Column="1"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="3"
                                 Margin="0,3">
                        <CheckBox Content="Muerte"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbMuerte" 
                                  Checked="chbMuerte_Checked"/>
                    </ListBoxItem>
                    <ListBoxItem Grid.Column="1"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="4"
                                 Margin="0,3">
                        <CheckBox Content="Nacimiento"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbNacimiento" 
                                  Checked="chbNacimiento_Checked"/>
                    </ListBoxItem>
                    <ListBoxItem Grid.Column="1"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="5"
                                 Margin="0,3">
                        <CheckBox Content="Reproductiva"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbReproductiva" 
                                  Checked="chbReproductiva_Checked"/>
                    </ListBoxItem>
                    <ListBoxItem Grid.Column="1"
                                 Grid.ColumnSpan="1" 
                                 Grid.Row="6"
                                 Margin="0,3"
                                 x:Name="lbiSalida">
                        <CheckBox Content="Salida"
                                  VerticalContentAlignment="Center"
                                  x:Name="chbSalida" 
                                  Checked="chbSalida_Checked"/>
                    </ListBoxItem>
                    -->
                </Grid>

            </GroupBox>
            <!--#endregion-->
            <!--#region Cantidad-->
            <TextBlock Text="Cantidad:"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Grid.Row="11"
                       Grid.Column="5"
                       Height="44"
                       Width="112"/>
            <TextBox Style="{DynamicResource TextBoxStyle1}"
                     x:Name="tbCant"
                     Height="45" 
                     Width="230"
                     Grid.Row="11"
                     Grid.RowSpan="2"
                     Grid.Column="6"
                     Grid.ColumnSpan="3"
                     VerticalAlignment="Top"
                     HorizontalContentAlignment="Center"
                     FontSize="23"/>
            <!--#endregion-->
            <!--#region Categoria-->
            <TextBlock Text="Categoría:"
                       FontSize="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Grid.Row="5"
                       Grid.Column="5"
                       Height="41"
                       Width="117" 
                       RenderTransformOrigin="0.458,-3.481"/>
            <ComboBox x:Name="cbCategoria" 
                      IsEnabled="True"
                      Height="45" 
                      Width="230"
                      Grid.Row="5"
                      Grid.Column="6"
                      Grid.ColumnSpan="3"
                      Grid.RowSpan="2"
                      VerticalAlignment="Top"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center"
                      FontSize="22"
                      Cursor="Hand"
                      Style="{DynamicResource ComboBoxStyle1}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border CornerRadius="10"
                                            SnapsToDevicePixels="True"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted"
                                                 Value="True">
                                            <Setter Property="Background" 
                                                    Value="Yellow"/>
                                            <Setter Property="BorderBrush" 
                                                    Value="Green"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <!--#endregion-->
            <!--#region BTN Agregar-->
            <Button Style="{DynamicResource CRUDButtonStyle}"
                    Grid.Row="13"
                    Grid.RowSpan="2"
                    Grid.Column="6"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Height="45"
                    Width="150"
                    Content="Agregar"
                    FontSize="25"
                    Foreground="White"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    x:Name="btnAdd" 
                    Click="btnAdd_Click"/>
            <!--#endregion-->
            <!--#region Fecha-->
            <DatePicker Style="{DynamicResource DatePickerStyle}" 
                        HorizontalAlignment="Center" 
                        Grid.Row="7"
                        Grid.RowSpan="2"
                        Grid.Column="5"
                        Grid.ColumnSpan="3"
                        VerticalAlignment="Top" 
                        Height="48" 
                        Width="300"
                        FontSize="25"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Background="Transparent"
                        x:Name="dpDate"
                        ToolTip="Calendario">
                <DatePicker.CalendarStyle>
                    <Style TargetType="{x:Type Calendar}">
                        <Setter Property="Background" 
                                Value="LightGoldenrodYellow"/>
                        <Setter Property="BorderBrush" 
                                Value="Azure"/>
                    </Style>
                </DatePicker.CalendarStyle>
            </DatePicker>
            <!--#endregion-->
            <!--#region Nombre-->
            <Label Content="Mi nombre es:"
                   FontSize="25"
                   Background="Transparent"
                   Grid.Row="9"
                   Grid.Column="5"
                   Grid.ColumnSpan="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Width="170"/>
            <ComboBox x:Name="cbUsuario"
                      Height="46"
                      Width="180"
                      Grid.Row="9"
                      Grid.RowSpan="3"
                      Grid.Column="6"
                      Grid.ColumnSpan="3"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Right"
                      Cursor="Hand"
                      IsReadOnly="True"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center"
                      FontSize="22"
                      Style="{DynamicResource ComboBoxStyle1}">

                <!-- Conservamos intencionalmente el ItemContainerStyle amarillo -->
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border CornerRadius="10"
                                            SnapsToDevicePixels="True"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="Yellow"/>
                                            <Setter Property="BorderBrush"
                                                    Value="Green"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <!--#endregion-->
        </Grid>
    </Border>
    <!--#endregion-->
</UserControl>
