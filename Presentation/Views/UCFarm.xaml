<UserControl x:Class="Presentation.Views.UCFarm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="565"
             d:DesignWidth="925">

    <Border CornerRadius="10"
            Background="#76D275"
            Padding="28">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Grid.Row="0"
                       Text="Establecimientos y lotes"
                       FontSize="42"
                       FontWeight="SemiBold"
                       Foreground="Black"
                       HorizontalAlignment="Center"/>

            <!-- Contenido -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Establecimientos -->
                <Border Grid.Column="0"
                        Background="#E8F5E9"
                        CornerRadius="12"
                        Padding="24"
                        MaxWidth="570"
                        MaxHeight="650"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="52"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Establecimientos"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#00701A"/>

                        <TextBlock Grid.Row="2"
                                   Text="Establecimiento existente"
                                   FontSize="17"
                                   Foreground="#263A29"/>

                        <ComboBox Grid.Row="4"
                                  x:Name="cBoxFarm"
                                  FontSize="22"
                                  Cursor="Hand"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="FarmName"
                                  SelectedValuePath="Id"
                                  Style="{DynamicResource ComboBoxStyle1}"
                                  SelectionChanged="cBoxFarm_SelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ComboBoxItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                                <Border CornerRadius="10"
                                                        SnapsToDevicePixels="True"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted"
                                                             Value="True">
                                                        <Setter Property="Background" Value="Yellow"/>
                                                        <Setter Property="BorderBrush" Value="Green"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock Grid.Row="6"
                                   Text="Nombre"
                                   FontSize="17"
                                   Foreground="#263A29"/>
                        <TextBox Grid.Row="8"
                                 x:Name="txtFarmName"
                                 FontSize="22"
                                 Padding="12,0"
                                 MaxLength="100"
                                 Height="40"
                                 VerticalContentAlignment="Center"
                                 Style="{DynamicResource TextBoxStyle1}"/>
                        <Grid Grid.Row="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    x:Name="btnAddFarm"
                                    Style="{DynamicResource CRUDButtonStyle}"
                                    Click="btnAddFarm_Click"
                                    Cursor="Hand"
                                    Width="100"
                                    Margin="0,10, 0, 0">
                                <TextBlock Text="Agregar"
                                           FontSize="18"
                                           Foreground="White"/>
                            </Button>
                            <Button Grid.Column="2"
                                    x:Name="btnEditFarm"
                                    Style="{DynamicResource CRUDButtonStyle}"
                                    Click="btnEditFarm_Click"
                                    Cursor="Hand"
                                    Width="100"
                                    Margin="0,10, 0, 0">
                                <TextBlock Text="Renombrar"
                                           FontSize="16"
                                           Foreground="White"/>
                            </Button>

                            <Button Grid.Column="4"
                                    x:Name="btnDeleteFarm"
                                    Style="{DynamicResource CRUDButtonStyle}"
                                    Click="btnDeleteFarm_Click"
                                    Cursor="Hand" 
                                    Width="100"
                                    Margin="0,10, 0, 0">
                                <TextBlock Text="Eliminar"
                                           FontSize="18"
                                           Foreground="White"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Lotes -->
                <Border Grid.Column="2"
                        Background="#E8F5E9"
                        CornerRadius="12"
                        Padding="24"
                        MaxWidth="570"
                        MaxHeight="650"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="52"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Lotes"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#00701A"/>
                        <TextBlock Grid.Row="2"
                                   Text="Lote del establecimiento seleccionado"
                                   FontSize="17"
                                   Foreground="#263A29"
                                   TextWrapping="Wrap"/>
                        <ComboBox Grid.Row="4"
                                  x:Name="cBoxLot"
                                  FontSize="22"
                                  Cursor="Hand"
                                  Style="{DynamicResource ComboBoxStyle1}"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="LotName"
                                  SelectedValuePath="Id"
                                  SelectionChanged="cBoxLot_SelectionChanged"
                                  IsEnabled="False">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ComboBoxItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                                <Border CornerRadius="10"
                                                        SnapsToDevicePixels="True"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted"
                                                             Value="True">
                                                        <Setter Property="Background" Value="Yellow"/>
                                                        <Setter Property="BorderBrush" Value="Green"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock Grid.Row="6"
                                   Text="Nombre"
                                   FontSize="17"
                                   Foreground="#263A29"/>
                        <TextBox Grid.Row="8"
                                 x:Name="txtLotName"
                                 FontSize="22"
                                 Padding="12,0"
                                 MaxLength="100"
                                 VerticalContentAlignment="Center"
                                 IsEnabled="False"
                                 Height="40"
                                 Style="{DynamicResource TextBoxStyle1}"/>
                        <Grid Grid.Row="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    x:Name="btnAddLot"
                                    Style="{DynamicResource CRUDButtonStyle}"
                                    Click="btnAddLot_Click"
                                    Cursor="Hand"
                                    IsEnabled="False"
                                    Margin="0,10, 0, 0">
                                <TextBlock Text="Agregar"
                                           FontSize="18"
                                           Foreground="White"/>
                            </Button>
                            <Button Grid.Column="2"
                                    x:Name="btnEditLot"
                                    Style="{DynamicResource CRUDButtonStyle}"
                                    Click="btnEditLot_Click"
                                    Cursor="Hand"
                                    IsEnabled="False"
                                    Margin="0,10, 0, 0">
                                <TextBlock Text="Renombrar"
                                           FontSize="16"
                                           Foreground="White"/>
                            </Button>
                            <Button Grid.Column="4"
                                    x:Name="btnDeleteLot"
                                    Style="{DynamicResource CRUDButtonStyle}"
                                    Click="btnDeleteLot_Click"
                                    Cursor="Hand"
                                    IsEnabled="False"
                                    Margin="0,10, 0, 0">
                                <TextBlock Text="Eliminar"
                                           FontSize="18"
                                           Foreground="White"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
