<UserControl x:Class="Presentation.Views.UCGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="565" 
             d:DesignWidth="925"
             Background="Transparent">
    <!--#region Contenido-->
    <Border CornerRadius="10"
            Background="#76d275">
        <Grid Name="GridTotal">
            <!--#region Cols & Rows-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="45"/>
                <RowDefinition/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <!--#endregion-->
            <!--#region Titulo-->
            <TextBlock Text="Grilla de Operaciones"
                       Foreground="Black"
                       FontSize="45"
                       Grid.Column="2"
                       Grid.ColumnSpan="2"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <!--#endregion-->
            <!--#region DataGrid-->
            <DataGrid Template="{DynamicResource DataGridTemplate}" 
                      Grid.Row="2"
                      Grid.ColumnSpan="4"
                      Grid.Column="1"
                      x:Name="dgRecord"
                      AutoGenerateColumns="False"
                      Background="GhostWhite"
                      Foreground="Black"
                      FontSize="15"
                      CanUserResizeColumns="True"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      RowBackground="Transparent"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="Black"
                      Margin="0,10,0,10"
                      IsReadOnly="True" 
                      CanUserReorderColumns="False" 
                      AlternationCount="1"
                      HorizontalContentAlignment="Center"
                      SelectionUnit="FullRow"
                      ItemsSource="{Binding RecordsView}">
                <DataGrid.AlternatingRowBackground>
                    <SolidColorBrush Color="#FF1F51BE" 
                                     Opacity="0.5"/>
                </DataGrid.AlternatingRowBackground>

                <DataGrid.Columns>
                    <DataGridTextColumn Visibility="Hidden"
                                        Width="75"
                                        Foreground="Black"
                                        Binding="{Binding id}"/>
                    <DataGridTextColumn Header="Fecha"
                                        MinWidth="80"
                                        Width="auto"
                                        MaxWidth="90"
                                        CanUserResize="False"
                                        Foreground="Black"
                                        Binding="{Binding date}"/>
                    <DataGridTextColumn Header="Usuario"
                                        Width="100" 
                                        MinWidth="75"
                                        MaxWidth="100"
                                        Foreground="Black"
                                        Binding="{Binding user}"/>
                    <DataGridTextColumn Header="Operación"
                                        MinWidth="150"
                                        Width="*"
                                        Foreground="Black"
                                        Binding="{Binding operation}"/>
                    <DataGridTextColumn Header="Establecimiento"
                                        MinWidth="150"
                                        Width="*"
                                        Foreground="Black"
                                        Binding="{Binding farm}"/>
                    <DataGridTextColumn Header="Lote"
                                        MinWidth="150"
                                        Width="*"
                                        Foreground="Black"
                                        Binding="{Binding lot}"/>
                    <DataGridTextColumn Header="Categoría"
                                        MinWidth="145"
                                        Width="Auto"
                                        MaxWidth="160"
                                        Foreground="Black"
                                        Binding="{Binding category}"/>
                    <DataGridTextColumn Header="Cantidad"
                                        Width="Auto"
                                        MinWidth="60"
                                        Foreground="Black"
                                        Binding="{Binding total}"/>
                    <DataGridTextColumn/>
                </DataGrid.Columns>

            </DataGrid>
            <!--#endregion-->
            <!--#region Buscador-->
            <Grid Height="45"
                  Grid.Column="1"
                  Grid.Row="3"
                  Margin="0,0,12,0">
                <TextBox x:Name="txtBuscar"
                         TextChanged="txtBuscar_TextChanged"
                         Padding="18,0"
                         FontSize="18"
                         VerticalContentAlignment="Center"
                         Style="{DynamicResource TextBoxStyle1}"/>
                <TextBlock Text="Buscar en los registros..."
                           Margin="18,0"
                           VerticalAlignment="Center"
                           Foreground="#8A8A8A"
                           FontSize="17"
                           FontStyle="Italic"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length,
                                                   ElementName=txtBuscar}"
                                             Value="0">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>
            </Grid>
            <!--<TextBox Style="{DynamicResource TextBoxStyle1}"  
                     Grid.Column="1"
                     Grid.Row="3" 
                     x:Name="txtBuscar" 
                     TextChanged="txtBuscar_TextChanged"/>-->
            <!--#endregion-->
            <!--#region BtnExportar-->
            <Button Style="{DynamicResource CRUDButtonStyle}"
                    Grid.Column="2"
                    Grid.Row="3"
                    x:Name="btnExport"
                    Margin="6,0"
                    Click="btnExport_Click">
                <TextBlock Text="Exportar CSV"
               FontSize="22"
               Foreground="White"/>
            </Button>
            <!--#endregion-->
            <!--#region BtnEditar-->
            <Button Style="{DynamicResource CRUDButtonStyle}" 
                    Grid.Column="3"
                    Grid.Row="3"
                    x:Name="btnEdit" 
                    Click="btnEdit_Click">
                <TextBlock Text="Editar"
                           FontSize="25"
                           Foreground="White"/>
            </Button>
            <!--#endregion-->
            <!--#region BtnEliminar-->
            <Button Style="{DynamicResource CRUDButtonStyle}" 
                    Grid.Column="4"
                    Grid.Row="3"
                    x:Name="btnDelete" 
                    Click="btnDelete_Click">
                <TextBlock Text="Eliminar"
                           FontSize="25"
                           Foreground="White"/>
            </Button>
            <!--#endregion-->
            <!--#region FRAME-->
            <Frame x:Name="frame" 
                   Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="6"
                   Grid.RowSpan="5"
                   Visibility="Visible"/>
            <!--#endregion-->
        </Grid>
    </Border>
    <!--#endregion-->
</UserControl>
